    {
      "name": "Chained — list users then get by id",
      "item": [
        {
          "name": "01 List users (store first id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const arr = pm.response.json();",
                  "const id = arr[0].id;",
                  "pm.expect(id, 'first user id').to.be.a('number');",
                  "pm.environment.set('userId', String(id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "02 Get user by stored userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const j = pm.response.json();",
                  "pm.expect(j).to.have.property('id');",
                  "pm.expect(String(j.id)).to.eql(pm.environment.get('userId'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    }
