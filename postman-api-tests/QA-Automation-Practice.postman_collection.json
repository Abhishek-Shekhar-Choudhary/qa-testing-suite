        },
        {
          "name": "POST create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response echoes payload with id', function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.include.keys('id', 'name', 'username');",
                  "    pm.expect(j.name).to.eql('Portfolio User');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
