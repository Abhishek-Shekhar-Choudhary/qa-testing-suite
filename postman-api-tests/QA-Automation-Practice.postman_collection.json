  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "GET list users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(8000);",
                  "});",
                  "pm.test('Body is non-empty user array with expected keys', function () {",
                  "    const arr = pm.response.json();",
                  "    pm.expect(arr).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(arr[0]).to.include.keys('id', 'name', 'username', 'email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "GET single user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('User object schema', function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.include.keys('id', 'name', 'email', 'address', 'company');",
                  "    pm.expect(j.id).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/1"
